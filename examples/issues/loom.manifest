# What this app does, for review. Generated by loomtest.Manifest;
# refresh it with go test -update and commit it with your change.

routes

  /  live page issues.MyIssues in issues.Shell
    auth: loom.SignedIn
    events, all handled by its layout:
      compose (on click, val-status), handled by its layout's (*issues.chrome).Events
    state in the URL, read by (*issues.MyIssuesPage).HandleParams; links within the route patch it

  /inbox  live page issues.Inbox in issues.Shell
    auth: loom.SignedIn
    events, handled by (*issues.InboxPage).Events:
      read_all (on click)

  /team/{key}  live page issues.TeamIssues in issues.Shell
    auth: loom.SignedIn
    events, handled by (*issues.TeamPage).Events:
      search (on input)
      compose (on click, val-team, val-status), handled by its layout's (*issues.chrome).Events
      menu (on toggle, val-menu)
      pick (on select, val-menu)
      menu_close (on close, val-menu)
      clear_filters (on click)
    state in the URL, read by (*issues.TeamPage).HandleParams; links within the route patch it

  /issue/{id}  live page issues.IssueDetail in issues.Shell
    auth: loom.SignedIn
    events, handled by (*issues.IssuePage).Events:
      set (on change, val-field)
      comment (on submit)
      menu (on toggle, val-menu)
      pick (on select, val-menu)
      menu_close (on close, val-menu)

layouts

  issues.Shell
    events, handled by (*issues.chrome).Events:
      compose (on click)
      help (on click)
      compose_close (on close, click)
      compose_submit (on submit)
      compose_menu (on toggle, val-menu)
      compose_pick (on select, val-menu)
      compose_menu_close (on close, val-menu)
      compose_field (on change, val-field)
      toast_close (on dismiss, click)
      help_close (on close)

mounts

  /auth  *auth.App
    auth: none
    routes: /sign-in, /sign-up, /forgot, /reset/{token}, /link/{token}, /two-factor, /account, /account/two-factor, POST /sign-out, GET /two-factor/begin/{token}
    rate limit: every route: 120 per minute by ip
    rate limit: /sign-in: 20 per minute by ip on sign_in, email_link
    rate limit: /sign-in: 5 per minute by email on sign_in, email_link
    rate limit: /sign-up: 20 per minute by ip on sign_up
    rate limit: /sign-up: 5 per minute by email on sign_up
    rate limit: /forgot: 20 per minute by ip on send
    rate limit: /forgot: 5 per minute by email on send
    rate limit: /reset/{token}: 20 per minute by ip on save
    rate limit: /link/{token}: 20 per minute by ip on sign_in
    rate limit: /two-factor: 20 per minute by ip on verify, set_up
    rate limit: /account: 10 per hour by user on save_password
    rate limit: /account: 5 per hour by user on new_codes, turn_off
    rate limit: /account/two-factor: 10 per minute by user on set_up
  /admin/jobs  *jobsweb.App
    auth: loom.SignedIn, issues.requireAdmin
    routes: /, /jobs, /jobs/{id}, /cron
  /dev/mail  *devmail.App
    auth: none
    dev only: 404 unless the app runs in dev
    routes: /, /{id}

