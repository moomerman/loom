# What this app does, for review. Generated by loomtest.Manifest;
# refresh it with go test -update and commit it with your change.

routes

  /  live page templates.TodoApp in templates.App
    auth: none
    events, handled by (*todo.TodoPage).Events:
      add_todo (on submit)
      toggle_todo (on change, val-id)
      delete_todo (on click, val-id)
      clear_completed (on click)
    re-renders when these tables change: todos
    state in the URL, read by (*todo.TodoPage).HandleParams; links within the route patch it

  /todos/{id}  live page templates.TodoDetail in templates.App
    auth: none
    events, handled by (*todo.TodoDetailPage).Events:
      toggle_todo (on click, val-id)
    re-renders when these tables change: todos

  /about  live page templates.About
    auth: none
    events: none

mounts

  /admin/jobs  *jobsweb.App
    auth: todo.requireAdmin
    routes: /, /jobs, /jobs/{id}, /cron

database (migrations)

  0001_create_todos.sql  tracks todos
    CREATE TABLE todos
    CREATE INDEX todos_user_id ON todos (user_id, id)
  0002_seed_guest_todos.sql
    1 statement changing rows of todos
  0003_todo_uuids.sql
    ALTER TABLE todos ALTER COLUMN id DROP DEFAULT
    ALTER TABLE todos ALTER COLUMN id TYPE uuid USING lpad(to_hex(id), 32, '0')::...
    DROP SEQUENCE todos_id_seq
    ALTER TABLE todos ADD CONSTRAINT todos_title_present CHECK (btrim(title) <> '')
  0004_insertion_order.sql
    ALTER TABLE todos ALTER COLUMN inserted_at SET DEFAULT clock_timestamp()
  0005_loom_clients.sql
    CREATE TABLE IF NOT EXISTS loom_clients
  0006_loom_user_sessions.sql
    CREATE TABLE IF NOT EXISTS loom_user_sessions
    CREATE INDEX IF NOT EXISTS loom_user_sessions_user ON loom_user_sessions (use...
  0007_loom_rate_limits.sql
    CREATE TABLE IF NOT EXISTS loom_rate_limits
  0008_loom_jobs.sql
    CREATE TABLE IF NOT EXISTS loom_jobs
    CREATE INDEX IF NOT EXISTS loom_jobs_fetch ON loom_jobs (queue, scheduled_at,...
    CREATE INDEX IF NOT EXISTS loom_jobs_lease ON loom_jobs (lease_until) WHERE s...
    CREATE INDEX IF NOT EXISTS loom_jobs_unique ON loom_jobs (unique_key, inserte...
    CREATE INDEX IF NOT EXISTS loom_jobs_finished ON loom_jobs (finished_at) WHER...
    CREATE INDEX IF NOT EXISTS loom_jobs_state ON loom_jobs (state, id)
    ALTER TABLE loom_jobs ADD COLUMN IF NOT EXISTS trace text NOT NULL DEFAULT ''
  0009_loom_nodes.sql
    CREATE TABLE IF NOT EXISTS loom_nodes

background jobs

  todo.PruneCompleted  queue default, 20 attempts, timeout 1m0s, args: none
  cron "0 3 * * *"  todo.PruneCompleted
  queue default  10 workers
  every node runs jobs and cron (Config.Jobs run)

broadcasts reach every node's pages, by Postgres NOTIFY (in-process without a database)
responses carry Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
