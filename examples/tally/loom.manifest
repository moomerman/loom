# What this app does, for review. Generated by loomtest.Manifest;
# refresh it with go test -update and commit it with your change.

routes

  /login  live page tally.Login
    auth: none
    events: none

  /  live page tally.Dashboard in tally.Shell
    auth: loom.SignedIn
    events, handled by (*tally.DashboardPage).Events:
      new_group (on click)
      close_group (on close, click)
      group_form (on change)
      create_group (on submit)
      toast_close (on dismiss, click)
    re-renders when these tables change: groups, members, expenses, shares, settlements, recurring, notifications

  /activity  live page tally.Activity in tally.Shell
    auth: loom.SignedIn
    events, handled by (*tally.ActivityPage).Events:
      mark_read (on click)
    re-renders when these tables change: groups, members, expenses, shares, settlements, recurring, notifications

  /groups/{id}  live page tally.GroupView in tally.Shell
    auth: loom.SignedIn
    events, handled by (*tally.GroupPage).Events:
      settle_up (on click, val-from, val-to, val-amount)
      add_expense (on click)
      search (on change, submit, input)
      filter_category (on click, val-category)
      remind (on click, val-debtor, val-cents)
      close_expense (on close, click)
      expense_form (on change)
      save_expense (on submit)
      close_settle (on close, click)
      settle_form (on change)
      save_settle (on submit)
      toast_close (on dismiss, click)
    re-renders when these tables change: groups, members, expenses, shares, settlements, recurring, notifications

  /groups/{id}/expenses/{eid}  live page tally.ExpenseView in tally.Shell
    auth: loom.SignedIn
    events, handled by (*tally.ExpensePage).Events:
      delete (on click)
      cancel_delete (on close, click)
      confirm_delete (on click)
    re-renders when these tables change: groups, members, expenses, shares, settlements, recurring, notifications

handlers

  POST /login  auth: none
  POST /logout  auth: none

mounts

  /admin/jobs  *jobsweb.App
    auth: loom.SignedIn, tally.requireAdmin
    routes: /, /jobs, /jobs/{id}, /cron

