Component TodoList @1:11
  Param todos []Todo @1:20
  Param filter string @1:34
  Element <ul> @3:1
    Text "\n  " @3:5
    Element <li> @4:3
      :for t <- todos @4:13
      :if (|| (. t done) (== filter "all"))
      :key (. t id)
      Attr class={(if (. t done) "done" "")} @4:69
      Text "\n    " @4:99
      Element <input> void @5:5
        Attr type="checkbox" @5:12
        Attr checked={(. t done)} @5:28
        Attr on:change="toggle" @5:45
        Attr val-id={(. t id)} @5:64
      Text "\n    " @5:80
      Interp (. t title) @6:5
      Text "\n  " @6:14
    Text "\n" @7:8
  Text "\n\n" @8:6
  Call <.footer> @10:1
    Attr count={(call len todos)} @10:10
    Slot <:left> @11:3
      Text "Items" @11:10
