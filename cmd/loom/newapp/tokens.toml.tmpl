# Design tokens: every color, spacing, radius, font size and font the
# app's styles use, written token(group.name) in a <style> block. Colors
# with { light, dark } follow the system's color scheme. `loom components
# add` adds the names the starter kit needs. See `loom docs components`.

[color]
page      = { light = "#f7f7f5", dark = "#141414" }
on-page   = { light = "#1f1f1f", dark = "#e8e8e8" }
accent    = { light = "#3451b2", dark = "#9db4ff" }
on-accent = { light = "#ffffff", dark = "#111111" }

[space]
2 = "0.5rem"
4 = "1rem"
6 = "1.5rem"
12 = "3rem"

[radius]
md = "4px"

[text]
md = "1rem"
xl = "3rem"

[font]
body = "system-ui, sans-serif"
